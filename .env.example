# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/outreach

# Session
SESSION_SECRET=replace-with-a-long-random-string

# Credential encryption (mailbox passwords, per-user OpenRouter keys)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# AI generation (OpenRouter) — platform-wide fallback key; users can add their own in Settings
PLATFORM_OPENROUTER_API_KEY=
PLATFORM_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
PLATFORM_KEY_DAILY_LIMIT=20

# Public URL — required for tracking pixel/link URLs to resolve for real recipients
PUBLIC_URL=https://yourdomain.com

PORT=3000
